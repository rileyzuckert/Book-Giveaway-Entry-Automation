# Copy this file to a new file named .env  (the README shows how), then fill in YOUR details.
# Keep the .env file private. Never upload it anywhere and never share it.
# No quotes are needed, and no spaces around the = sign.

# Your StoryGraph login
SG_EMAIL=you@example.com
SG_PASSWORD=your-storygraph-password

# Your private ntfy topic name (a long random one; see the README, step 5)
NTFY_TOPIC=giveaways-replace-me-with-random-letters

# Your country, written the way StoryGraph writes it (for example: United States, Canada, United Kingdom)
MY_COUNTRY=United States
